# ---- Gateway ----
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
# Max providers to try per request (defaults to all).
MAX_ATTEMPTS=
# Per-upstream request timeout in ms.
REQUEST_TIMEOUT_MS=120000

# ---- PWA auth ----
# The single user who can log in to the PWA.
PWA_EMAIL=you@example.com
# Your password, base64-encoded. The real password is decode(PWA_PASS).
# Generate with:  node -e "console.log(require('base-64').encode('your-password'))"
# or:             printf 'your-password' | base64
PWA_PASS=
# Secret used to sign session JWTs. Set a long random value so sessions survive
# restarts. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# How long a login stays valid (persistent session). e.g. 30d, 12h, 7d.
JWT_EXPIRES_IN=30d

# ---- Context sharing with Claude ----
# The gateway writes a transcript of your prompts into a folder you pick in the
# PWA, so Claude (working in the same repo) can see the lighter tasks handled
# here. These are just defaults; the active folder is chosen at runtime.
# Where the chosen folder + on/off flag are persisted between restarts.
STATE_FILE=
# Optional: seed the context folder before you've picked one in the PWA.
CONTEXT_DIR=
# How many recent interactions to keep in the readable HISTORY.md.
CONTEXT_MAX_ENTRIES=50
# Optional: commit & push the transcript so Claude on the WEB can read it.
# Leave false if Claude runs locally on this machine (working-tree files suffice).
# When true, the chosen folder must be a git repo with a push remote configured.
CONTEXT_GIT_SYNC=false
# Coalesce a burst of messages into one commit (ms).
CONTEXT_GIT_DEBOUNCE_MS=15000

# ---- Gemini (free) : complex refactors ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Routing knobs: score = weight + complexity(0..1) * complexityWeight
GEMINI_WEIGHT=40
GEMINI_COMPLEXITY_WEIGHT=60
GEMINI_COOLDOWN_MS=60000

# ---- DeepSeek (free) : second for complex ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_WEIGHT=55
DEEPSEEK_COMPLEXITY_WEIGHT=35
DEEPSEEK_COOLDOWN_MS=60000

# ---- Mistral (free) : favored for simple edits ----
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_WEIGHT=60
MISTRAL_COMPLEXITY_WEIGHT=10
MISTRAL_COOLDOWN_MS=60000

# ---- OpenRouter (free) : favored for simple edits ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://localhost
OPENROUTER_TITLE=free-llm-api
OPENROUTER_WEIGHT=58
OPENROUTER_COMPLEXITY_WEIGHT=10
OPENROUTER_COOLDOWN_MS=60000

# ---- Local Qwen Coder via llama.cpp : last-resort fallback ----
# Only used when every remote above is rate-limited.
LOCAL_MODEL=qwen2.5-coder
LOCAL_BASE_URL=http://localhost:8080/v1
LOCAL_API_KEY=sk-local
LOCAL_WEIGHT=10
LOCAL_COMPLEXITY_WEIGHT=0
LOCAL_COOLDOWN_MS=15000
